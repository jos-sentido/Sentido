{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/sitio",
      "destination": "/sitio/index.html"
    },
    {
      "source": "/comercial/:slug",
      "destination": "/propuestas/:slug"
    },
    {
      "source": "/:prospecto",
      "destination": "/propuestas/:prospecto"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
