# Variables de entorno del panel — COPIAR a .env.local (ya está en .gitignore)
# y, para producción, configurarlas en Vercel → Settings → Environment Variables.
# NUNCA comitear los valores reales.

# ── Metricool (fuente de datos del panel) ──
# Se sacan en Metricool → avatar arriba a la derecha → Configuración →
# pestaña de API / Conexiones. Son dos valores:
METRICOOL_USER_ID=
METRICOOL_USER_TOKEN=

# ── Ya existentes en el proyecto (referencia) ──
# RESEND_API_KEY=
# ADMIN_PASSWORD=
# ADMIN_TOKEN=
